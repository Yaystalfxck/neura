from fastapi import APIRouter, Depends, HTTPException, status HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from datetime import datetime, timedelta
from app.database import get_db
from app.models import User, PasswordResetCode
from app.schemas import (
    PasswordResetRequest,
    PasswordResetVerify,
    PasswordResetConfirm,
    APIResponse,
)
from app.utils import get_password_hash
from app.email_service import send_email, generate_reset_password_html, generate_reset_password_text
import random

router = APIRouter(prefix="/api", tags=["Auth"])


def generate_reset_code() -> str:
    """Генерация 6-значного кода"""
    return str(random.randint(100000, 999999))


@router.post("/reset-password")
async def request_password_reset(
    data: PasswordResetRequest,
    db: AsyncSession = Depends(get_db)
):
    """Запрос на сброс пароля - отправка кода"""
    # Проверка существования пользователя
    result = await db.execute(
        select(User).where(User.email == data.email)
    )
    user = result.scalar_one_or_none()

    # Для безопасности не сообщаем, существует ли пользователь
    if not user:
        return {"success": True, "message": "Если пользователь существует, код будет отправлен"}

    # Генерация кода
    code = generate_reset_code()
    expires_at = datetime.utcnow() + timedelta(minutes=15)

    # Удаление старых кодов
    await db.execute(
        select(PasswordResetCode).where(PasswordResetCode.email == data.email)
    )
    old_codes = await db.execute(
        select(PasswordResetCode).where(PasswordResetCode.email == data.email)
    )
    for old_code in old_codes.scalars().all():
        await db.delete(old_code)

    # Сохранение нового кода
    reset_code = PasswordResetCode(
        email=data.email,
        code=code,
        expires_at=expires_at,
    )
    db.add(reset_code)
    await db.commit()

    # Отправка email
    html_content = generate_reset_password_html(code, data.email)
    text_content = generate_reset_password_text(code, data.email)
    
    email_result = await send_email(
        to=data.email,
        subject="Восстановление пароля - Neura Trading",
        html=html_content,
        text=text_content,
    )

    if not email_result.get("success"):
        # В development режиме показываем код в консоли
        print(f"📧 CODE FOR TEST: {code}")
        return {
            "success": False,
            "error": "Ошибка отправки email",
            "code": code,  # Только для development!
        }

    return {
        "success": True,
        "message": "Код отправлен на email",
        "expires_in": 15,
    }


@router.put("/reset-password")
async def verify_reset_code(
    data: PasswordResetVerify,
    db: AsyncSession = Depends(get_db)
):
    """Проверка кода подтверждения"""
    # Поиск действующего кода
    result = await db.execute(
        select(PasswordResetCode)
        .where(PasswordResetCode.email == data.email)
        .where(PasswordResetCode.code == data.code)
        .where(PasswordResetCode.used == False)
        .where(PasswordResetCode.expires_at > datetime.utcnow())
        .order_by(PasswordResetCode.created_at.desc())
        .limit(1)
    )
    reset_code = result.scalar_one_or_none()

    if not reset_code:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Неверный или просроченный код",
        )

    return {
        "success": True,
        "message": "Код подтвержден",
        "valid": True,
    }


@router.patch("/reset-password")
async def confirm_password_reset(
    data: PasswordResetConfirm,
    db: AsyncSession = Depends(get_db)
):
    """Установка нового пароля"""
    # Проверка длины пароля
    if len(data.new_password) < 6:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Пароль должен содержать минимум 6 символов",
        )

    # Проверка кода
    result = await db.execute(
        select(PasswordResetCode)
        .where(PasswordResetCode.email == data.email)
        .where(PasswordResetCode.code == data.code)
        .where(PasswordResetCode.used == False)
        .where(PasswordResetCode.expires_at > datetime.utcnow())
        .limit(1)
    )
    reset_code = result.scalar_one_or_none()

    if not reset_code:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Неверный или просроченный код",
        )

    # Проверка существования пользователя
    user_result = await db.execute(
        select(User).where(User.email == data.email)
    )
    user = user_result.scalar_one_or_none()

    if not user:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Пользователь не найден",
        )

    # Обновление пароля
    user.password = get_password_hash(data.new_password)
    
    # Пометка кода как использованный
    reset_code.used = True

    await db.commit()

    return {
        "success": True,
        "message": "Пароль успешно изменен",
    }


@router.get("/reset-password")
async def resend_reset_code(
    email: str,
    db: AsyncSession = Depends(get_db)
):
    """Повторная отправка кода"""
    # Проверка на частую отправку
    result = await db.execute(
        select(PasswordResetCode)
        .where(PasswordResetCode.email == email)
        .where(PasswordResetCode.created_at > datetime.utcnow() - timedelta(minutes=1))
        .where(PasswordResetCode.used == False)
        .limit(1)
    )
    recent_code = result.scalar_one_or_none()

    if recent_code:
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Код уже отправлен. Подождите 1 минуту.",
            headers={"Retry-After": "60"},
        )

    # Генерация нового кода
    code = generate_reset_code()
    expires_at = datetime.utcnow() + timedelta(minutes=15)

    new_reset_code = PasswordResetCode(
        email=email,
        code=code,
        expires_at=expires_at,
    )
    db.add(new_reset_code)
    await db.commit()

    # Отправка email
    html_content = generate_reset_password_html(code, email)
    text_content = generate_reset_password_text(code, email)
    
    email_result = await send_email(
        to=email,
        subject="Восстановление пароля - Neura Trading",
        html=html_content,
        text=text_content,
    )

    if not email_result.get("success"):
        print(f"📧 CODE FOR TEST: {code}")
        return {
            "success": False,
            "error": "Ошибка отправки email",
            "code": code,
        }

    return {
        "success": True,
        "message": "Код отправлен повторно",
        "retry_after": 60,
    }
