# ===========================================
# NEURA BACKEND - Environment Variables
# ===========================================
# Скопируйте этот файл в .env и заполните значениями
# cp .env.example .env

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DATABASE_URL=postgresql+asyncpg://neura:neura_password@postgres:5432/neura_db

# -------------------------------------------
# JWT Settings
# -------------------------------------------
SECRET_KEY=your-super-secret-key-min-32-characters-long-for-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# SMTP Email Settings (Gmail)
# -------------------------------------------
# Для Gmail используйте App Password, не обычный пароль!
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# -------------------------------------------
# API Settings
# -------------------------------------------
# Для production замените localhost на ваш домен
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# -------------------------------------------
# PocketOption Affiliate API
# -------------------------------------------
# Получите API токен и Partner ID в кабинете партнера
# https://affiliate.pocketoption.com
POCKETOPTION_API_TOKEN=your-api-token
NEXT_PUBLIC_PARTNER_ID=your-partner-id
POCKETOPTION_EMAIL=your-po-email
POCKETOPTION_PASSWORD=your-po-password

# -------------------------------------------
# PocketOption WebSocket (для сигналов)
# -------------------------------------------
# Опционально: для получения сигналов через WebSocket
# SessionToken из cookies браузера (DevTools → Application → Cookies)
POCKETOPTION_SESSION_TOKEN=your-session-token-from-browser-cookies
POCKETOPTION_UID=your-pocketoption-user-id
POCKETOPTION_WS_URL=wss://api-us-north.po.market/socket.io/?EIO=4&transport=websocket
